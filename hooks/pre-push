#!/bin/bash

PUSHED=$(git diff --name-only HEAD @{u} 2>/dev/null || git diff --name-only HEAD)

if echo "$PUSHED" | grep -q '^src/'; then
  echo "Running backend tests..."
  ./mvnw test -q
  STATUS=$?
  if [ $STATUS -ne 0 ]; then
    echo ""
    echo "Backend tests failed. Run './mvnw test' for details."
    exit 1
  fi
fi

if echo "$PUSHED" | grep -q '^frontend/'; then
  if git rev-parse @{u} >/dev/null 2>&1; then
    VITEST_BASE=$(git merge-base HEAD @{u})
  fi

  echo "Running ESLint..."
  cd frontend
  npm run lint
  STATUS=$?
  if [ $STATUS -ne 0 ]; then
    echo ""
    echo "ESLint failed. Run 'npm run lint' in frontend/ for details."
    exit 1
  fi

  echo "Running npm audit..."
  npm audit --audit-level=high
  STATUS=$?
  if [ $STATUS -ne 0 ]; then
    echo ""
    echo "npm audit found high-severity vulnerabilities. Fix them or run 'npm audit --audit-level=high' for details."
    exit 1
  fi

  echo "Running Vitest suite (changed files only)..."
  if [ -n "$VITEST_BASE" ]; then
    npx vitest run --changed="$VITEST_BASE"
  else
    npm test -- --run
  fi
  STATUS=$?
  if [ $STATUS -ne 0 ]; then
    echo ""
    echo "Vitest tests failed. Run 'npm test -- --run' in frontend/ for details."
    exit 1
  fi

  if echo "$PUSHED" | grep -q -E '^(frontend/src|frontend/index\.html)'; then
    echo "Running accessibility tests..."
    npm run test:a11y
    STATUS=$?
    if [ $STATUS -ne 0 ]; then
      echo ""
      echo "Accessibility tests failed. Run 'npm run test:a11y' in frontend/ for details."
      exit 1
    fi
  fi
fi
