#!/bin/bash

PUSHED=$(git diff --name-only HEAD @{u} 2>/dev/null || git diff --name-only HEAD)

if echo "$PUSHED" | grep -q '^src/'; then
  echo "Running backend tests..."
  # Strip API keys so the test environment matches CI (where these vars are absent).
  # Without this, a locally-set key can mask missing defaults in application.properties.
  env -u OPENROUTER_API_KEY -u GOOGLE_API_KEY ./mvnw test -q
  STATUS=$?
  if [ $STATUS -ne 0 ]; then
    echo ""
    echo "Backend tests failed. Run './mvnw test' for details."
    exit 1
  fi
fi

if echo "$PUSHED" | grep -q '^frontend/'; then
  if git rev-parse @{u} >/dev/null 2>&1; then
    VITEST_BASE=$(git merge-base HEAD @{u})
  fi

  echo "Running ESLint..."
  cd frontend
  npm run lint
  STATUS=$?
  if [ $STATUS -ne 0 ]; then
    echo ""
    echo "ESLint failed. Run 'npm run lint' in frontend/ for details."
    exit 1
  fi

  echo "Running npm audit..."
  npm audit --audit-level=high
  STATUS=$?
  if [ $STATUS -ne 0 ]; then
    echo ""
    echo "npm audit found high-severity vulnerabilities. Fix them or run 'npm audit --audit-level=high' for details."
    exit 1
  fi

  echo "Running Vitest suite (changed files only)..."
  if [ -n "$VITEST_BASE" ]; then
    npx vitest run --changed="$VITEST_BASE"
  else
    npm test -- --run
  fi
  STATUS=$?
  if [ $STATUS -ne 0 ]; then
    echo ""
    echo "Vitest tests failed. Run 'npm test -- --run' in frontend/ for details."
    exit 1
  fi

  if echo "$PUSHED" | grep -q -E '^(frontend/src|frontend/index\.html)'; then
    echo "Running map accessibility tests..."
    npm run test:a11y -- --grep-invert="/method|/credits|/accessibility"
    STATUS=$?
    if [ $STATUS -ne 0 ]; then
      echo ""
      echo "Map accessibility tests failed. Run 'npm run test:a11y' for details."
      exit 1
    fi

    if echo "$PUSHED" | grep -q -E '^(frontend/src/(StaticPageShell|Method|Credits|Accessibility|index)\.[a-z]+|frontend/index\.html|frontend/src/__tests__/a11y/static-pages\.a11y\.spec\.ts)'; then
      echo "Running static page accessibility tests..."
      npm run test:a11y -- --grep="/method|/credits|/accessibility"
      STATUS=$?
      if [ $STATUS -ne 0 ]; then
        echo ""
        echo "Static page accessibility tests failed. Run 'npm run test:a11y' for details."
        exit 1
      fi
    fi
  fi
fi
