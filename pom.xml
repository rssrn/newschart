<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>uk.rossarnold</groupId>
    <artifactId>newschart</artifactId>
    <version>${revision}</version>
    <name>NewsChart</name>
    <description>NewsChart project for Spring Boot</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <revision>0.26.2</revision>
        <java.version>21</java.version>
        <!-- Override: keep Netty ahead of Boot's managed version (4.2.17.Final as of Boot 4.1.1). Originally pinned for
             DNS bailiwick CVEs (CVE-2026-45674, CVE-2026-47691); raised to 4.2.16.Final for CVE-2026-56820 (OCSP
             CertificateID validation, NVD 9.1 CRITICAL); raised to 4.2.17.Final for CVE-2026-75595 (SslClientHelloHandler
             SNI-context bypass, NVD 9.1 CRITICAL) — affects only per-SNI mutual-TLS server setups, which this app is not.
             Raised to 4.2.19.Final for ~20 CVEs fixed in 4.2.18 (HTTP/1 request smuggling, HTTP/2 and HTTP/3/QPACK DoS,
             QUIC hostname verification; up to NVD 8.7). -->
        <netty.version>4.2.19.Final</netty.version>
        <!-- Override: Boot 4.1.1 manages Kotlin 2.3.21, affected by CVE-2026-53914 (build-cache metadata
             deserialization, NVD 9.8; fixed in 2.4.20). Kotlin arrives only transitively via Spring AI's OpenAI
             starter (kotlin-reflect) and okhttp/okio. -->
        <kotlin.version>2.4.21</kotlin.version>
        <!-- Override: keep Tomcat one patch ahead of Boot's managed 11.0.22 and raise past 11.0.23. 11.0.23 fixed
             CVE-2026-55276, CVE-2026-53434 and CVE-2026-55956 (Tomcat rates these Low/Low/Moderate; NVD scores
             55276/53434 at 9.1 CRITICAL). 11.0.24 fixes CVE-2026-59083 and CVE-2026-59084 (Tomcat: Low; NVD: 9.1
             CRITICAL), both in components this app does not use (RewriteValve, EncryptInterceptor clustering).
             11.0.25 fixes CVE-2026-65905, CVE-2026-65637, CVE-2026-65182 and CVE-2026-68525 (Tomcat rates these
             Low/Moderate/Important/Low; NVD scores 65905/65637/65182 at 9.8/9.1/9.1 - the OWASP dependency-check
             CVSS>=9.0 build-failure threshold). -->
        <tomcat.version>11.0.25</tomcat.version>
        <!-- Override: keep Jackson ahead of Boot's managed 3.1.5 / 2.21.5. CVE-2026-110879 (jackson-databind, NVD 9.2)
             tripped the OWASP dependency-check CVSS>=9.0 build-failure threshold; 3.1.8 / 2.21.8 also include the
             fixes for CVE-2026-68497, -91776, -91777 and others. -->
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
        <nvd.api.key>${env.NVD_API_KEY}</nvd.api.key>
    </properties>
    <dependencyManagement>
      <dependencies>
          <dependency>
              <groupId>org.springframework.ai</groupId>
              <artifactId>spring-ai-bom</artifactId>
              <version>2.0.1</version>
              <type>pom</type>
              <scope>import</scope>
          </dependency>
          <!-- Guava arrives via io.grpc:grpc-api at 33.6.0-android; CVE-2026-102554 (CompactHashMap/CompactHashSet
               deserialization DoS, NVD 5.9) affects versions through 33.7.1. Keep the -android flavour grpc expects. -->
          <dependency>
              <groupId>com.google.guava</groupId>
              <artifactId>guava</artifactId>
              <version>33.7.2-android</version>
          </dependency>
      </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai</artifactId>
        </dependency>
        <!-- OWASP version patch - spring-ai-starter-model-google-genai includes grpc 1.70.0 which has CVE-2026-33186 -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <version>1.84.0</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-context</artifactId>
            <version>1.84.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
            <exclusions>
                <!-- okhttp -> okio drags in the legacy kotlin-stdlib-common 1.9.10 jar, which kotlin.version can't
                     move (since Kotlin 2.x it's a pom-only stub; kotlin-stdlib carries its classes). Excluding it
                     stops CVE-2026-53914 matching the straggler. -->
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-stdlib-common</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
            <version>2.0.13</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <version>5.12.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar -Xshare:off</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>13.0.0</version>
                <configuration>
                    <failBuildOnCVSS>9</failBuildOnCVSS>
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <!-- ossIndexAnalyzerUrl is not set: dependency-check-core 13.0.0 already
                         defaults analyzer.ossindex.url to https://api.guide.sonatype.com. -->
                    <ossIndexUsername>${env.OSS_INDEX_USERNAME}</ossIndexUsername>
                    <ossIndexPassword>${env.OSS_INDEX_PASSWORD}</ossIndexPassword>
                    <nvdApiKey>${nvd.api.key}</nvdApiKey>
                    <!-- Bulk-load CVEs from NIST's static feeds rather than paging the NVD API ~180
                         times. Since NVD's 2026-06-17 schema change touched ~95% of records, the API
                         has been overloaded and cold updates crawl (see #89). The API is still used
                         for the recent delta. {0} is the year placeholder. -->
                    <nvdDatafeedUrl>https://nvd.nist.gov/feeds/json/cve/2.0/nvdcve-2.0-{0}.json.gz</nvdDatafeedUrl>
                    <!-- The yearly feeds (up to ~20 MB each) download in parallel. On a slow link each stream's
                         share of bandwidth stalls past the default read timeout, and one failed year aborts the
                         whole update, so a cold local scan never completes. 10 minutes is generous enough;
                         CI is unaffected (fast runners, cached data). -->
                    <readTimeout>600000</readTimeout>
                    <connectionTimeout>60000</connectionTimeout>
                    <suppressionFile>${project.basedir}/owasp-suppressions.xml</suppressionFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
