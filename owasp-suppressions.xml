<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        False positives: MongoDB Server CVEs incorrectly matched against Spring Boot Data MongoDB
        These CVEs affect MongoDB Server, not the Spring Data MongoDB client library
    -->
    <suppress>
        <notes>
            CVEs for MongoDB Server (database) incorrectly matched against Spring Boot Data MongoDB (Java client).
            Spring Boot Data MongoDB 4.0.1 is a Spring Framework module, not MongoDB Server 4.0.1.
        </notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring-boot.*mongodb.*@4\.0\.1$</packageUrl>
        <vulnerabilityName regex="true">^CVE-.*$</vulnerabilityName>
        <cpe>cpe:/a:mongodb:mongodb</cpe>
    </suppress>
    <!--
        False positive: CVE-2020-29582 affects Kotlin before 1.4.21 (incorrect default permissions in temp files).
        We use Kotlin 2.2.21 (via jackson-module-kotlin) which is well past the fix.
    -->
    <suppress>
        <notes>Fixed in Kotlin 1.4.21; we use 2.2.21 via jackson-module-kotlin.</notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.module/jackson-module-kotlin@.*$</packageUrl>
        <cve>CVE-2020-29582</cve>
    </suppress>
    <!--
        No fix released yet: CVE-2026-53914 (unsafe deserialization in Kotlin build-cache metadata) is
        fixed in 2.4.20, but only a 2.4.20-Beta1 exists on Maven Central as of 2026-07-08 - no stable
        release to upgrade to. Kotlin-stdlib is pulled in transitively via spring-core's optional Kotlin
        support; this app is pure Java and never touches Kotlin's Gradle build-cache deserialization path,
        so it isn't reachable at runtime. Revisit once 2.4.20 (or later) reaches GA and remove this suppression.
    -->
    <suppress>
        <notes>No stable fix available yet (2.4.20 is still Beta1); not reachable at runtime in this pure-Java app. Revisit when 2.4.20 GA ships.</notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/.*@.*$</packageUrl>
        <cve>CVE-2026-53914</cve>
    </suppress>
</suppressions>