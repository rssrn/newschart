<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        False positives: MongoDB Server CVEs incorrectly matched against Spring Boot Data MongoDB
        These CVEs affect MongoDB Server, not the Spring Data MongoDB client library
    -->
    <suppress>
        <notes>
            CVEs for MongoDB Server (database) incorrectly matched against Spring Boot Data MongoDB (Java client).
            These artifacts are Spring Boot modules and carry Spring Boot's version, which the NVD matcher
            mistakes for a MongoDB Server version. Deliberately version-agnostic: an exact-version regex here
            (previously @4.0.1) silently stopped matching the moment Spring Boot was upgraded, letting the
            false positives resurface.
        </notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring-boot.*mongodb.*@.*$</packageUrl>
        <vulnerabilityName regex="true">^CVE-.*$</vulnerabilityName>
        <cpe>cpe:/a:mongodb:mongodb</cpe>
    </suppress>
    <!--
        False positive: CVE-2020-29582 affects Kotlin before 1.4.21 (incorrect default permissions in temp files).
        Every Kotlin artifact we resolve is well past that: 2.3.21 for kotlin-stdlib/-jdk7/-jdk8/-reflect,
        and 1.9.10 for the kotlin-stdlib-common straggler.
        This rule previously targeted com.fasterxml.jackson.module/jackson-module-kotlin and recorded
        "zero matches" on every scan - the CVE actually matches the org.jetbrains.kotlin coordinates.
    -->
    <suppress>
        <notes>Fixed in Kotlin 1.4.21; every Kotlin artifact we resolve is far past it. Version-agnostic by design.</notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/.*@.*$</packageUrl>
        <cve>CVE-2020-29582</cve>
    </suppress>
    <!--
        No fix released yet: CVE-2026-53914 (unsafe deserialization in Kotlin build-cache metadata) is
        fixed in 2.4.20, but as of 2026-08-02 Maven Central's latest is still only 2.4.20-Beta2 - no stable
        release to upgrade to. Kotlin arrives transitively via spring-ai-starter-model-openai -> kotlin-reflect
        -> kotlin-stdlib (2.3.21); this app is pure Java and never touches Kotlin's Gradle build-cache
        deserialization path, so it isn't reachable at runtime. Revisit once 2.4.20 (or later) reaches GA
        and remove this suppression.
    -->
    <suppress>
        <notes>No stable fix available yet (2.4.20 is still at Beta2); not reachable at runtime in this pure-Java app. Revisit when 2.4.20 GA ships.</notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/.*@.*$</packageUrl>
        <cve>CVE-2026-53914</cve>
    </suppress>
</suppressions>