{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0"
  },
  "overrides": {
    "d3-color": "^3.1.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:a11y": "playwright test --config=playwright-a11y.config.ts",
    "test:a11y:components": "vitest run --reporter=verbose a11y.test",
    "test:layout": "node ../scripts/run-layout-tests.mjs",
    "lint": "eslint ."
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "last 2 versions",
      "not dead",
      "iOS >= 14",
      "Safari >= 14"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react-swc": "^4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "jsdom": "^29",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4",
    "vitest-axe": "^0.1.0"
  }
}
